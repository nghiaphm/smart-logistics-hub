APP_ENV=development

SERVER_HOST=0.0.0.0
SERVER_PORT=8000
FRONTEND_URL=http://localhost:3000

# Metrics (internal Prometheus scraping endpoint on a separate port)
METRICS_ENABLED=true
METRICS_HOST=0.0.0.0
METRICS_PORT=9090

# Run database migrations on container startup (docker-entrypoint.sh)
AUTO_MIGRATE=true

MARIADB_ENABLED=true
MARIADB_HOST=localhost
MARIADB_PORT=3307
MARIADB_USER=root
MARIADB_PASSWORD=root
MARIADB_DB_NAME=smart_logistics
# MARIADB_URI=root:root@tcp(localhost:3307)/smart_logistics?parseTime=true

REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL_CACHE=300

S3_ENABLED=false
AWS_REGION=ap-southeast-1
S3_BUCKET=
S3_ENDPOINT=
S3_USE_PATH_STYLE=false

KEYCLOAK_SERVER_URL=http://localhost:8180
KEYCLOAK_REALM=web-app-project
KEYCLOAK_CLIENT_ID=fastapi_backend_client
DEV_SKIP_AUTH=true
