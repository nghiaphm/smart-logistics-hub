# Biến môi trường frontend — bản mẫu cho production.
#
# Cách dùng:
#   1. Copy file này thành `.env.production` (đã bị gitignore — không bao giờ
#      commit giá trị thật), hoặc set qua CI/CD secrets / hosting platform.
#   2. Điền giá trị THẬT của môi trường production.
#
# LƯU Ý: Các biến `NEXT_PUBLIC_*` được inline vào client bundle NGAY TẠI
# `next build` — phải có giá trị đúng lúc build. Với Dockerfile, truyền qua
# `--build-arg` (xem frontend/Dockerfile). Build thiếu biến => client bundle
# inline `undefined`.

# Base URL backend API. api-client sẽ nối path vào sau (VD /workspaces).
# Production: domain thật của backend, ví dụ https://api.example.com/api/v1
NEXT_PUBLIC_API_URL=

# URL Keycloak server (luồng OIDC authorization code).
# Production: domain thật của Keycloak, ví dụ https://auth.example.com
NEXT_PUBLIC_KEYCLOAK_URL=

# Keycloak realm. Dev dùng `smart-logistics`; production có thể khác realm.
NEXT_PUBLIC_KEYCLOAK_REALM=

# Keycloak public client (không cần client secret). Dev: `frontend-web`.
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=
